{
  "expo": {
    "name": "MangaRecs",
    "slug": "inklore",
    "scheme": "mangarecs",
    "version": "1.5.2",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mangarecs.app",
      "associatedDomains": [
        "applinks:mangarecs.net"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "Used to upload your profile photo.",
        "NSPhotoLibraryUsageDescription": "Used to select your profile photo.",
        "NSMotionUsageDescription": "Used for the subtle tilt effect in your MangaRecap.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080614"
      },
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.mangarecs.app",
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "mangarecs.net",
              "pathPrefix": "/series"
            },
            {
              "scheme": "https",
              "host": "mangarecs.net",
              "pathPrefix": "/discussion"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7B5CFF",
          "sounds": [
            "./assets/sounds/notification.mp3"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Used to select your profile photo."
        }
      ],
      "expo-font",
      "expo-asset",
      [
        "@sentry/react-native",
        {
          "organization": "lucky-gqu",
          "project": "react-native"
        }
      ],
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#080614"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d8e9e8d4-41cd-4b74-86c5-ffee8087dcf0"
      }
    },
    "owner": "kazymodo",
    "updates": {
      "url": "https://u.expo.dev/d8e9e8d4-41cd-4b74-86c5-ffee8087dcf0"
    }
  }
}
